{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "react",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "jsx-a11y",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "rules": {
    "eqeqeq": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@ui-sdk/react",
            "message": "@ui-sdk/react has no root entry. Import each component from its own entry, for example @ui-sdk/react/button."
          },
          {
            "name": "@ui-sdk/core",
            "message": "Import from a named @ui-sdk/core entry, and only when @ui-sdk/react does not ship the component."
          }
        ],
        "patterns": [
          {
            "group": [
              "@ui-sdk/core/internal/*",
              "@ui-sdk/*/dist/*"
            ],
            "message": "Private ui-sdk paths can change without notice. Use the documented entries."
          }
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/purity": "error",
    "react/immutability": "error",
    "react/refs": "error",
    "react/static-components": "error",
    "react/no-unstable-nested-components": "error",
    "react/no-array-index-key": "error",
    "react/jsx-key": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/no-clone-element": "error",
    "react/no-react-children": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/self-closing-comp": "error",
    "react/forbid-dom-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "style",
            "message": "Style from data-slot and state attributes in src/index.css instead of inline styles."
          }
        ]
      }
    ],
    "react/forbid-component-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "style",
            "message": "Style from data-slot and state attributes in src/index.css instead of inline styles."
          },
          {
            "propName": "as",
            "message": "ui-sdk parts change their element with the render prop, never as."
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/ban-ts-comment": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-default-export": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "unicorn/no-array-sort": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/engine/**",
        "src/mahjong/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/engine is pure TypeScript: no React, DOM or UI imports."
              },
              {
                "name": "react-dom",
                "message": "src/engine is pure TypeScript: no React, DOM or UI imports."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@ui-sdk/*",
                  "react/*",
                  "react-dom/*",
                  "../ui/*",
                  "../App",
                  "*.css"
                ],
                "message": "src/engine is pure TypeScript: no React, DOM or UI imports."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "src/engine must run without a browser."
          },
          {
            "name": "document",
            "message": "src/engine must run without a browser."
          },
          {
            "name": "localStorage",
            "message": "src/engine must run without a browser. Persist from src/ui."
          },
          {
            "name": "sessionStorage",
            "message": "src/engine must run without a browser. Persist from src/ui."
          },
          {
            "name": "navigator",
            "message": "src/engine must run without a browser."
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/test/**"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/expect-expect": "error",
        "vitest/no-identical-title": "error",
        "vitest/no-conditional-expect": "off",
        "vitest/require-to-throw-message": "off",
        "unicorn/consistent-function-scoping": "off",
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": [
        "src/engine/benchmark.test.ts",
        "src/holdem/levels.test.ts",
        "src/mahjong/levels.test.ts"
      ],
      "rules": {
        "no-console": "off",
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "e2e/ios/*.mjs"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "e2e/**",
        "playwright.config.ts"
      ],
      "rules": {
        "no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-non-null-assertion": "off",
        "no-underscore-dangle": "off"
      }
    }
  ]
}
